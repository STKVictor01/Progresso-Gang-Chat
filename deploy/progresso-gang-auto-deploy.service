[Unit]
Description=Atualizacao automatica do Progresso Gang
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
UMask=0077
TimeoutStartSec=30min
ExecStart=/usr/bin/flock -n /run/progresso-gang-auto-deploy.lock /usr/bin/python3 /usr/local/lib/progresso-gang-auto-deploy/auto-deploy.py
