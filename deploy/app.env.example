NODE_ENV=production
PG_CHAT_DATABASE=postgres
# Opcional: deixe desativado até concluir backup, migração, SMTP e testes.
PG_CHAT_AUTH=local
# PG_CHAT_AUTH=supabase
# SUPABASE_URL=https://projeto.supabase.co
# SUPABASE_PUBLISHABLE_KEY=preencher_no_servidor
# SUPABASE_SECRET_KEY=preencher_no_servidor
PG_CHAT_SITE_ORIGIN=https://gang.exemplo.com.br
PG_CHAT_MUSIC_MAX_ROOMS=2
LIVEKIT_URL=wss://live.gang.exemplo.com.br
# Na VPS com rede host, use o serviço local para presença e bot de música.
LIVEKIT_INTERNAL_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=SUBSTITUIR
LIVEKIT_API_SECRET=configure_seu_segredo
DATABASE_URL=postgresql://USUARIO:SENHA_CODIFICADA@HOST:5432/postgres
